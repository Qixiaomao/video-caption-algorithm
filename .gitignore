# Ignore model checkpoints
# --- 系统与编辑器配置 ---
.vscode/
.chainlit/
.DS_Store

# --- Python 编译缓存 (必须忽略) ---
__pycache__/
*.py[cod]

# --- 模型权重与大文件 (核心瘦身项) ---
checkpoints/
*.pth
*.bin
*.ckpt
*.safetensors
*.onnx

# --- 数据集与素材 ---
data/
Image/

# Source package, not dataset material. The broad data/ rule above otherwise
# hides the caption dataloader from version control.
!src/data/
!src/data/__init__.py
!src/data/data_loader.py

# --- 运行日志与生成结果 ---
logs/
eval_results/
figs/
outputs/
runs/
# --- Local CUDA/CuPy cache ---
.cupy_cache/
# --- Local environment and secrets ---
.env
.venv/

# --- Local profiling / experiment outputs ---
reports/

# --- Project-local notes / drafts / skills (not for this code push) ---
docs/
prompts/
chainlit.md
requirements.full-freeze.txt
public_posts/

# Publication audit additions: weights, caches, secrets and third-party media
*.pt
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.hdf5
*.faiss
*.engine
*.plan
*.zip
*.tar
*.gz
*.7z
*.mp4
*.avi
*.webm
*.mov
*.mkv
.env.*
!.env.example
.secrets/
credentials*.json
*.pem
*.key
.agents/
.codex/
.idea/
venv/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.log
*.nsys-rep
*.ncu-rep
*.sqlite
*.sqlite3
*.docx
*.pdf
experiments/*.local.json
models/
